{
  "name": "cave-public",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "tsc && vite build --config vite/config.prod.mjs",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs --output-type err-long --ignore-known",
    "depcruise:debt": "depcruise src --config .dependency-cruiser.cjs --output-type err --no-ignore-known",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "code-map:check": "node scripts/code-map.mjs check",
    "code-map:bless": "node scripts/code-map.mjs bless"
  },
  "dependencies": {
    "@bbob/preset-react": "^4.3.1",
    "@bbob/react": "^4.3.1",
    "@emotion/is-prop-valid": "^1.4.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@floating-ui/react": "^0.27.16",
    "@fontsource-variable/crimson-pro": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@posthog/react": "^1.9.0",
    "flexlayout-react": "^0.8.17",
    "framer-motion": "^12.25.0",
    "idb": "^8.0.3",
    "immer": "^11.1.3",
    "json-logic-js": "^2.0.5",
    "miniplex": "^2.0.0",
    "nanoid": "^5.1.6",
    "phaser": "^3.90.0",
    "posthog-js": "^1.371.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-virtuoso": "^4.18.1",
    "stats.js": "^0.17.0",
    "ulid": "^3.0.2",
    "zod": "^4.3.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.6",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/stats.js": "^0.17.4",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.6",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.5.0",
    "jsdom": "^27.4.0",
    "terser": "^5.44.1",
    "ts-morph": "^27.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  }
}
