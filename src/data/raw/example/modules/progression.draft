{
  "draftOptions": {
    "reward_cave_body": {
      "id": "reward_cave_body",
      "title": "Body Mastery",
      "description": "I learned every muscle, every bone, every pore on my skin.\nMy movement is perfectly aware, every gesture precise.\nMy hearts beat at the pace I wish.\nI am in control.\n\n+5 [icon=attr_body]Body",
      "rarity": "common",
      "icon": "attr_body",
      "oneOff": true,
      "payload": [
        {
          "type": "GAIN_UNDERSTANDING",
          "understandingId": "master_of_body"
        }
      ]
    },
    "reward_cave_mind": {
      "id": "reward_cave_mind",
      "title": "Mind Mastery",
      "description": "I looked inside, and gained mastery of my mind.\nMy thoughts are obedient, exploring my desires.\nMy emotions are precisely balanced.\nI am in control of my mind.\n\n+5 [icon=attr_mind]Mind",
      "rarity": "common",
      "icon": "attr_mind",
      "oneOff": true,
      "payload": [
        {
          "type": "GAIN_UNDERSTANDING",
          "understandingId": "master_of_mind"
        }
      ]
    },
    "reward_cave_social": {
      "id": "reward_cave_social",
      "title": "Social Mastery",
      "description": "I took full ownership of my bodies' social urges.\nMy facial expressions show only what I want them to.\nMy voice and words are precise tools.\nI am in control.\n\n+5 [icon=attr_social]Social",
      "rarity": "common",
      "icon": "attr_social",
      "oneOff": true,
      "payload": [
        {
          "type": "GAIN_UNDERSTANDING",
          "understandingId": "master_of_social"
        }
      ]
    },
