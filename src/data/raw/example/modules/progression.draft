    "opt_mnvpcwi6_5m0k": {
      "id": "opt_mnvpcwi6_5m0k",
      "title": "Hidden",
      "description": "I learned to hide myself from human eyes.\nTo walk softly. To keep myself to the shadows.\nTo place myself where human eyes do not linger.\nI am the shadows.\n\n+20 max [color=gold]Suspicion[/color] - delays the Purge",
      "rarity": "none",
      "icon": "unknown",
      "oneOff": true,
      "payload": [
        {
          "type": "GAIN_UNDERSTANDING",
          "understandingId": "hidden"
        }
      ]
    },
    "opt_mnvpep93_1jnj": {
      "id": "opt_mnvpep93_1jnj",
      "title": "Careful",
      "description": "I learned to be careful in my interactions.\nTo always cover my tracks, physical and social.\nTo be vigilant for signs of human attention.\nI only reveal what I must.\n\n+20 max [color=gold]Suspicion[/color] - delays the Purge",
      "rarity": "none",
      "icon": "unknown",
      "oneOff": true,
      "payload": [
        {
          "type": "GAIN_UNDERSTANDING",
          "understandingId": "careful"
        }
      ]
    },
    "opt_mnvpfbu2_jp8k": {
      "id": "opt_mnvpfbu2_jp8k",
      "title": "Prudent",
      "description": "I like being ready when I become conscious.\nI can feel the egg, waiting for me.\nIt responds to my attention.\nPreparing more sustenance.\n\n+300% to all [icon=egg]Egg production",
      "rarity": "none",
      "icon": "unknown",
      "oneOff": true,
      "payload": [
        {
          "type": "GAIN_UNDERSTANDING",
          "understandingId": "prudent"
        }
      ]
    },
    "opt_mnvpg3m9_8gnr": {
      "id": "opt_mnvpg3m9_8gnr",
      "title": "Adaptable",
      "description": "The world is full of variety, of change.\nI must change with it, grow into it.\nI absorb the old and embrace the new.\nI adapt.\n\n\n+10% [icon=xp]XP",
      "rarity": "none",
      "icon": "unknown",
      "oneOff": true,
      "payload": [
        {
          "type": "GAIN_UNDERSTANDING",
          "understandingId": "adaptable"
        }
      ]
    },
    "opt_mnvpgq9g_a1fe": {
      "id": "opt_mnvpgq9g_a1fe",
      "title": "Formless",
      "description": "I am the shape of my bodies.\nFlowing, filling the containers of mind and flesh.\nI envelop, absorb, change, become.\nThe world gives me form.\n\n+10% [icon=xp]XP",
      "rarity": "none",
      "icon": "unknown",
      "oneOff": true,
      "payload": [
        {
          "type": "GAIN_UNDERSTANDING",
          "understandingId": "formless"
        }
      ]
    },
    "opt_mnvph6sk_kgfj": {
      "id": "opt_mnvph6sk_kgfj",
      "title": "Cache",
      "description": "The Egg grows from moist cracks in the cavern walls.\nI can feel it there, separate but a part of me.\nThere are deeper crevasses to reach.\nMore sustenance to bubble up into the Egg.\n\n+100% to all [icon=egg]Egg production",
      "rarity": "none",
      "icon": "unknown",
      "oneOff": true,
      "payload": [
        {
          "type": "GAIN_UNDERSTANDING",
          "understandingId": "cache"
        }
      ]
    }
