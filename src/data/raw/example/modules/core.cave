  "guidances": [
    {
      "id": "ongoing_suspicion",
      "attention": [],
      "imageUrl": null,
      "presentation": "modal",
      "title": "Suspicion",
      "text": "Suspicion tracks how close the Patriarchy is to finding you. Rising Suspicion means the Purge is getting closer."
    },
    {
      "id": "ongoing_survival_spiral",
      "attention": [],
      "imageUrl": null,
      "presentation": "modal",
      "title": "Bodies At Risk",
      "text": "First take care of [icon=food]Food - starving bodies take damage over time and will eventually die.\n\nInsufficient [icon=heat]Heat makes bodies cold. Cold bodies output half [icon=attr_body]Body power, making it harder to get out of the spiral.\n\nWhen there is not enough [icon=heat]Heat or [icon=food]Food in Cave, the [icon=attr_body]Body, [icon=attr_mind]Mind, and [icon=attr_social]Social bonuses it provides to bodies drop proportionally.\n\nIf you can't get out of the spiral, shut down everything unnecessary for immediate survival.\n\nFirst make sure your bodies are not starving.\n\nThen divert all power to Hearth until they're not cold."
    },
    {
      "id": "ongoing_purge_active",
      "attention": [],
      "imageUrl": null,
      "presentation": "modal",
      "title": "The Purge",
      "text": "The Purge is underway. \n\nIt would be a good time to absorb your bodies.\n\nThey will be hunted down, one by one, until none remain. \n\nAnd then you will sleep."
    },
    {
      "id": "node_callout",
      "attention": [
        "stop_time",
        "hide_time_controls",
        "hide_notifications",
        "hide_all_but_self",
        "show_attention_effect_on_self"
      ],
      "imageUrl": null,
      "presentation": "node_callout",
      "target": {
        "kind": "entity_id",
        "entityId": "sys_world"
      },
      "slot": "top",
      "text": "Top Callout Test"
    },
    {
      "id": "draft",
      "attention": [
        "hide_time_controls"
      ],
      "presentation": "draft_guidance",
      "targetOptionId": "foraging_option"
    },
    {
      "id": "draft_comment",
      "attention": [],
      "imageUrl": null,
      "presentation": "screen_callout",
      "text": "For the tutorial, only Foraging is enabled.",
      "screenSlot": "bottom_right"
    },
    {
      "id": "node_bottom_callout",
      "attention": [],
      "imageUrl": null,
      "presentation": "node_callout",
      "target": {
        "kind": "entity_id",
        "entityId": "sys_world"
      },
      "slot": "bottom",
      "text": "Node bottom callout"
    },
    {
      "id": "screen_top_left",
      "attention": [],
      "imageUrl": null,
      "presentation": "screen_callout",
      "text": "Describe this guidance.",
      "screenSlot": "top_left"
    },
    {
      "id": "modal",
      "attention": [
        "stop_time",
        "hide_time_controls",
        "hide_notifications"
      ],
      "imageUrl": null,
      "presentation": "modal",
      "title": "",
      "text": "Describe this guidance."
    },
    {
      "id": "screen_bottom_left",
      "attention": [],
      "imageUrl": null,
      "presentation": "screen_callout",
      "text": "The important notifications can be found here.\n\nClick on a temporary one to dismiss it.\n",
      "screenSlot": "bottom_left"
    },
    {
      "id": "screen_bottom_right",
      "attention": [],
      "imageUrl": null,
      "presentation": "screen_callout",
      "text": "The time control are here.\n\nYou can pause/resume game and change time scale here.\n",
      "screenSlot": "bottom_right"
    },
    {
      "id": "pause_modal",
      "attention": [
        "stop_time"
      ],
      "imageUrl": null,
      "presentation": "modal",
      "title": "",
      "text": "The game autosaves every 5 seconds.\n\nThere are also save/load buttons in the menu."
    },
    {
      "id": "node_callout_no_pause",
      "attention": [],
      "imageUrl": null,
      "presentation": "node_callout",
      "target": {
        "kind": "entity_id",
        "entityId": "sys_world"
      },
      "slot": "top",
      "text": "Text"
    },
    {
      "id": "orbiting_carriers",
      "attention": [
        "stop_time",
        "hide_time_controls",
        "hide_notifications"
      ],
      "imageUrl": "tutorials/orbiting_habiti.png",
      "presentation": "modal",
      "title": "Unclaimed Habiti",
      "text": "These white orbs circling Cave are unclaimed lifetime experiences.\n\nTap them to internalize the Habiti.\n\nInternalized lifetime experiences make Cave stronger, and remain between runs.\n\nCollecting them is one of the main ways for Cave to grow."
    }
  ],
  "tutorials": [
    {
      "id": "intro_0",
      "selfDefinition": {
        "kind": "auto"
      },
      "enterConditionIds": [
        "game_started"
      ],
      "guidances": [
        {
          "guidanceId": "node_callout",
          "textOverride": "Welcome!\n\nSelect Cave to proceed"
        }
      ],
      "onComplete": [],
      "exitConditionIds": [
        "self_selected"
      ]
    },
    {
      "id": "draft_tut",
      "selfDefinition": {
        "kind": "entity_id",
        "entityId": "sys_world"
      },
      "enterConditionIds": [
        "draft_open"
      ],
      "guidances": [
        {
          "guidanceId": "draft"
        },
        {
          "guidanceId": "draft_comment"
        }
      ],
      "onComplete": [],
      "exitConditionIds": [
        "draft_completed"
      ]
    },
    {
      "id": "intro_1",
      "selfDefinition": {
        "kind": "auto"
      },
      "enterConditionIds": [
        "self_selected"
      ],
      "guidances": [
        {
          "guidanceId": "node_callout",
          "textOverride": "This is Cave - the protagonist of this story.\n\nCave's attributes - [icon=attr_body]Body, [icon=attr_mind]Mind, [icon=attr_social]Social - are added to those of each of Cave's bodies. \n\nCave stores [icon=heat]Heat and [icon=food]Food - the more, the bigger bodies' bonus.\n\n"
        },
        {
          "guidanceId": "node_bottom_callout",
          "textOverride": "Click outside Cave to continue"
        }
      ],
      "onComplete": [],
      "exitConditionIds": [
        "self_unselected"
      ]
    },
    {
      "id": "explore_tut_0",
      "selfDefinition": {
        "kind": "spawned_with_tag",
        "tag": "cave_exploration"
      },
      "enterConditionIds": [
        "explore_exists"
      ],
      "guidances": [
        {
          "guidanceId": "node_callout_no_pause",
          "textOverride": "This is the [icon=explore]Explore task.\n\nWhen it is fully powered, it will unlock the next part of the game.\n\nEach next [icon=explore]Explore [icon=activity]cycle costs more than the last."
        },
        {
          "guidanceId": "node_bottom_callout",
          "textOverride": "Assign the body here"
        }
      ],
      "onComplete": [],
      "exitConditionIds": [
        "body_assigned"
      ]
    },
    {
      "id": "absorption_tut_0",
      "selfDefinition": {
        "kind": "spawned_with_tag",
        "tag": "absorption"
      },
      "enterConditionIds": [
        "can_absorb_safely"
      ],
      "guidances": [
        {
          "guidanceId": "node_callout",
          "textOverride": "I am ready to grow.\nNeed to absorb my bodies for that."
        },
        {
          "guidanceId": "node_bottom_callout",
          "textOverride": "Select the Still Pool to continue."
        }
      ],
      "onComplete": [],
      "exitConditionIds": [
        "self_selected"
      ]
    },
    {
      "id": "absorption_tut_1",
      "selfDefinition": {
        "kind": "spawned_with_tag",
        "tag": "absorption"
      },
      "enterConditionIds": [
        "absorption_0_tut_complete"
      ],
      "guidances": [
        {
          "guidanceId": "node_callout_no_pause",
          "textOverride": "Assign a body here,\n\nOr click Select Bodies"
        }
      ],
      "onComplete": [],
      "exitConditionIds": [
        "body_assigned"
      ]
    },
    {
      "id": "absorption_tut_2",
      "selfDefinition": {
        "kind": "spawned_with_tag",
        "tag": "absorption"
      },
      "enterConditionIds": [
        "select_bodies_open"
      ],
      "guidances": [
        {
          "guidanceId": "screen_top_left",
          "textOverride": "Select the bodies you wish to absorb.\n\nThey will be destroyed, but strengthen Cave permanently in doing so.\n\nTheir Lifetime Experiences (Habiti) will become Cave's."
        }
      ],
      "onComplete": [],
      "exitConditionIds": [
        "processing_ongoing"
      ]
    },
    {
      "id": "out_of_food_tut",
      "selfDefinition": {
        "kind": "entity_id",
        "entityId": "sys_world"
      },
      "enterConditionIds": [
        "out_of_food"
      ],
      "guidances": [
        {
          "guidanceId": "modal",
          "titleOverride": "Starvation!",
          "textOverride": "Your bodies are out of [icon=food]food!\n\nHungry bodies take damage over time, and will eventually starve to death.\n\nYou should feed them, or use them up."
        }
      ],
      "onComplete": [],
      "exitConditionIds": []
    },
    {
      "id": "out_of_heat_tut",
      "selfDefinition": {
        "kind": "entity_id",
        "entityId": "sys_world"
      },
      "enterConditionIds": [
        "out_of_heat"
      ],
      "guidances": [
        {
          "guidanceId": "modal",
          "textOverride": "Your bodies are cold!\n\nCold bodies output only 50% [icon=attr_body]Body power. A cold Cave's comfort is also low, further reducing the effectiveness of bodies.\n\nTo restore Cave [icon=heat]heat, you might have to assign all your bodies to [icon=heat]heat production."
        }
      ],
      "onComplete": [],
      "exitConditionIds": []
    },
    {
      "id": "purge_tutorial",
      "selfDefinition": {
        "kind": "entity_id",
        "entityId": "sys_world"
      },
      "enterConditionIds": [
        "purge_started"
      ],
      "guidances": [
        {
          "guidanceId": "modal",
          "titleOverride": "The Purge has found you!",
          "textOverride": "The Patriarchy's magic monopoly enforcers have learned of your existence.\n\nThey will kill your bodies, one by one. \n\nThey are unstoppable.\n\nIt would be a good idea to absorb the bodies before the Purge gets to them."
        }
      ],
      "onComplete": [],
      "exitConditionIds": []
    },
    {
      "id": "3_bodies",
      "selfDefinition": {
        "kind": "entity_id",
        "entityId": "sys_world"
      },
      "enterConditionIds": [
        "3_bodies"
      ],
      "guidances": [
        {
          "guidanceId": "modal",
          "textOverride": "Each body consumes [icon=heat]Heat and [icon=food]Food, and contributes [icon=attr_body]Body, [icon=attr_mind]Mind, and [icon=attr_social]Social power.\n\nTaking in too many bodies too quickly, without preparation, can send you into a cold or starvation spiral.\n\nLuring new bodies also draws the attention of the Purge.\n\nBe careful..."
        }
      ],
      "onComplete": [],
      "exitConditionIds": []
    },
    {
      "id": "last_body",
      "selfDefinition": {
        "kind": "spawned_with_tag",
        "tag": "killer"
      },
      "enterConditionIds": [
        "last_body"
      ],
      "guidances": [
        {
          "guidanceId": "pause_modal",
          "titleOverride": "All Bodies Assigned!",
          "textOverride": "You have assigned all your bodies to a destructive task.\n\nWhen the assigned bodies will finish the task, they will die.\n\nCave will lie dormant, until another body stumbles in, and a new run begins.\n\nUnassign a body if that is not your intention."
        }
      ],
      "onComplete": [],
      "exitConditionIds": []
    },
    {
      "id": "tut_complete",
      "selfDefinition": {
        "kind": "spawned_with_tag",
        "tag": "foraging"
      },
      "enterConditionIds": [
        "foraging_exists"
      ],
      "guidances": [
        {
          "guidanceId": "pause_modal",
          "titleOverride": "Tutorial Zone Complete",
          "textOverride": "You have completed the tutorial zone!\n\nFrom now on, your Cave’s [icon=heat]Heat and [icon=food]Food can fall below 50%.\n\nAs these levels drop, your bodies become less efficient.\n\nIf either one reaches 0, your bodies will become cold and/or hungry.\n\nTry to prevent that—bodies can starve to death.\n\nGood luck!"
        }
      ],
      "onComplete": [
        {
          "type": "MUTATE",
          "target": "sys_world.state.tutorial_mode",
          "op": "SET",
          "value": 0
        }
      ],
      "exitConditionIds": []
    },
    {
      "id": "assign_body_to_forage",
      "selfDefinition": {
        "kind": "spawned_with_tag",
        "tag": "foraging"
      },
      "enterConditionIds": [
        "foraging_exists",
        "tut_complete_complete"
      ],
      "guidances": [
        {
          "guidanceId": "node_callout_no_pause",
          "textOverride": "Assign a body here\n\nCave likes it when there's a bit of food stashed away"
        }
      ],
      "onComplete": [],
      "exitConditionIds": [
        "body_assigned"
      ]
    },
    {
      "id": "pick_up_body",
      "selfDefinition": {
        "kind": "spawned_with_tag",
        "tag": "body"
      },
      "enterConditionIds": [
        "intro_1_completed"
      ],
      "guidances": [
        {
          "guidanceId": "node_callout_no_pause",
          "textOverride": "Right-click on or near a body to pick it up"
        }
      ],
      "onComplete": [],
      "exitConditionIds": [
        "body_in_pointer"
      ]
    },
    {
      "id": "drop_body",
      "selfDefinition": {
        "kind": "spawned_with_tag",
        "tag": "egg"
      },
      "enterConditionIds": [
        "pick_up_body_complete",
        "body_in_pointer"
      ],
      "guidances": [
        {
          "guidanceId": "node_callout_no_pause",
          "textOverride": "This is the Egg.\n\nAssign the body here by left-clicking near the [icon=egg]egg while holding a body."
        }
      ],
      "onComplete": [],
      "exitConditionIds": [
        "body_assigned"
      ]
    },
    {
      "id": "habiti",
      "selfDefinition": {
        "kind": "auto"
      },
      "enterConditionIds": [
        "orbiting_carriers"
      ],
      "guidances": [
        {
          "guidanceId": "orbiting_carriers"
        }
      ],
      "onComplete": [],
      "exitConditionIds": []
    },
    {
      "id": "dormancy",
      "selfDefinition": {
        "kind": "auto"
      },
      "enterConditionIds": [
        "run_2"
      ],
      "guidances": [
        {
          "guidanceId": "pause_modal",
          "titleOverride": "Wakefulness Cycles",
          "textOverride": "This is not the end, nor the beginning.\n\nCave slept, and woke up again.\n\nYears passed, and the world continued.\n\nThe Habiti and Understandings you have gained are still with you.\n\nThis is how Cave grows - learn, absorb, then sleep, and wake up again, stronger."
        }
      ],
      "onComplete": [],
      "exitConditionIds": []
    }
  ],
