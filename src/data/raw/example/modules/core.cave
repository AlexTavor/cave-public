  "habiti": {
    "Human": {
      "id": "Human",
      "label": "Human",
      "description": "The core lifetime experience shared by all people. \nThis is what being human feels like.",
      "summary": "",
      "type": "species",
      "effects": [
        {
          "type": "add_absorption_xp_conversion",
          "amount": 0.05,
          "description": "+5% [icon=xp]XP"
        }
      ],
      "excludes": []
    },
    "Woman": {
      "id": "Woman",
      "label": "Woman",
      "description": "A life lived as a woman - the gender Patriarchy considers subservient. \nExpected by society to submit, to be quiet, to serve. \nTo hide your strength.",
      "summary": "",
      "type": "gender",
      "effects": [
        {
          "type": "add_cave_attribute",
          "attribute": "social",
          "amount": 1,
          "description": "+1 [icon=attr_social]Social"
        }
      ],
      "excludes": []
    },
    "Man": {
      "id": "Man",
      "label": "Man",
      "description": "The lifetime experience of being a man in the Patriarchy. The officially dominant gender. \nA lifetime of faking strength, of hiding vulnerability.\nOf fearing you are not man enough.",
      "summary": "",
      "type": "gender",
      "effects": [
        {
          "type": "add_cave_attribute",
          "attribute": "body",
          "amount": 1,
          "description": "+1 [icon=attr_body]Body"
        }
      ],
      "excludes": []
    },
    "Peasant": {
      "id": "Peasant",
      "label": "Peasant",
      "description": "A life spent working the land. \nWaking up at dawn, and working until dusk in the summer.  \nOf praying that the harvest will last. \nOf winters spent huddled, hoping for spring.",
      "summary": "",
      "type": "profession",
      "effects": [
        {
          "type": "add_cave_attribute",
          "attribute": "body",
          "amount": 1,
