  "understanding": {
    "what_am_i": {
      "id": "what_am_i",
      "label": "More Than The Sum Of My Parts",
      "description": "I am not my bodies. They die, and I remain.\n\nWhen I absorb them, their memories become part of me. I can recall every detail of every life I have lived.\n\nYet without bodies, I remember nothing and feel nothing. Without them, I do not exist at all.\n\nNothing in those memories tells me what I am.\n\nNo one I have absorbed has ever known anything like me.",
      "effects": [
        {
          "type": "add_resource_gain_multiplier",
          "resource": "xp",
          "amount": 0.1,
          "description": "+10% [icon=xp]XP"
        }
      ]
    },
    "i_am_unborn": {
      "id": "i_am_unborn",
      "label": "Unborn",
      "description": "I was not carried here in a body. I waited here, somehow, unconscious. \nThings do not appear from nothing.\nI still do not know how I came to be.\nBut I was not born.",
      "effects": [
        {
          "type": "add_cave_attribute",
          "attribute": "body",
          "amount": 3,
          "description": "+3 [icon=attr_body]Body"
        },
        {
          "type": "add_cave_attribute",
          "attribute": "mind",
          "amount": 3,
          "description": "+3 [icon=attr_mind]Mind"
        },
        {
          "type": "add_cave_attribute",
          "attribute": "social",
          "amount": 3,
          "description": "+3 [icon=attr_social]Social"
        }
      ]
    },
    "do_locals_know_of_me": {
      "id": "do_locals_know_of_me",
      "label": "Incognito",
      "description": "I lived enough lives in Hommlet to know it inside out.\nI know their stories, their secrets, their buried and forgotten knowledge.\n\nNothing like me was ever here before.",
      "effects": [
        {
          "type": "add_producer_output_multiplier",
          "producerTag": "hommlet",
          "amount": 1,
          "description": "+100% to all [icon=hommlet]Hommlet production"
        }
      ]
    },
    "i_can_go_hard": {
      "id": "i_can_go_hard",
      "label": "Can Go Hard",
      "description": "I can push my bodies beyond human limits.\nRun until my tendons snap.\nIgnore any pain.\n\n",
      "effects": [
        {
          "type": "add_cave_attribute",
          "attribute": "body",
          "amount": 10,
          "description": "+10 [icon=attr_body]Body"
        }
      ]
    },
    "does_patriarchy_know_of_me": {
      "id": "does_patriarchy_know_of_me",
      "label": "Obfuscated",
      "description": "I found and absorbed all that the local Patriarchy agents know.\n\nThere are many non-human sentients in the world.\n\nGoblins live in the mountains to the east. Giant squid rule the seas.\n\nVampires hide in the cities. Forest spirits dwell in the woods, strange and mute.\n\nBut no whisper of anything like me has ever reached this Trading Post.",
      "effects": [
        {
          "type": "add_producer_output_multiplier",
          "producerTag": "trading_post",
          "amount": 1,
          "description": "+100% to all [icon=trading_post]Trading Post production"
        }
      ]
    },
    "how_big_can_i_get": {
      "id": "how_big_can_i_get",
      "label": "Limitless",
      "description": "I do not diminish with new bodies. \nThey are all me. I feel like I can grow forever.",
      "effects": [
        {
          "type": "add_absorption_xp_conversion",
          "amount": 0.1,
          "description": "+10% [icon=xp]XP"
        }
      ]
    },
    "master_of_body": {
      "id": "master_of_body",
      "label": "Body Mastery",
      "description": "I learned every muscle, every bone, every pore on my skin.\nMy movement is perfectly aware, every gesture precise.\nMy hearts beat at the pace I wish.\nI am in control.",
      "effects": [
        {
          "type": "add_cave_attribute",
          "attribute": "body",
          "amount": 5,
          "description": "+5 [icon=attr_body]Body"
        }
      ]
    },
    "master_of_mind": {
      "id": "master_of_mind",
      "label": "Mind Master",
      "description": "I looked inside, and gained mastery of my mind.\nMy thoughts are obedient, exploring my desires.\nMy emotions are precisely balanced.\nI am in control of my mind.",
      "effects": [
        {
          "type": "add_cave_attribute",
          "attribute": "mind",
          "amount": 5,
          "description": "+5 [icon=attr_mind]Mind"
        }
      ]
    },
    "master_of_social": {
      "id": "master_of_social",
      "label": "Social Mastery",
      "description": "I took full ownership of my bodies' social urges.\nMy facial expressions show only what I want them to.\nMy voice and words are precise tools.\nI am in control.",
      "effects": [
        {
          "type": "add_cave_attribute",
          "attribute": "social",
          "amount": 5,
          "description": "+5 [icon=attr_social]Social"
        }
      ]
    },
    "hidden": {
      "id": "hidden",
      "label": "Hidden",
      "description": "I learned to hide myself from human eyes.\nTo walk softly. To keep myself to the shadows.\nTo place myself where human eyes do not linger.\nI am the shadows.",
      "effects": [
        {
          "type": "increase_max_purge",
          "amount": 20,
          "description": "+20 max [color=gold]Suspicion[/color] - delays the Purge"
        }
      ]
    },
    "careful": {
      "id": "careful",
      "label": "Careful",
      "description": "I learned to be careful in my interactions.\nTo always cover my tracks, physical and social.\nTo be vigilant for signs of human attention.\nI only reveal what I must.",
      "effects": [
        {
          "type": "increase_max_purge",
          "amount": 20,
          "description": "+20 max [color=gold]Suspicion[/color] - delays the Purge"
        }
      ]
    },
    "prudent": {
      "id": "prudent",
      "label": "Prudent",
      "description": "I like being ready when I become conscious.\nI can feel the egg, waiting for me.\nIt responds to my attention.\nPreparing more sustenance.",
      "effects": [
        {
          "type": "add_producer_output_multiplier",
          "producerTag": "egg",
          "amount": 3,
          "description": "+300% to all [icon=egg]Egg production"
        }
      ]
    },
    "sdaptable": {
      "id": "sdaptable",
      "label": "Adaptable",
      "description": "The world is full of variety, of change.\nI must change with it, grow into it.\nI absorb the old and embrace the new.\nI adapt.",
      "effects": [
        {
          "type": "add_absorption_xp_conversion",
          "amount": 0.1,
          "description": "+10% [icon=xp]XP"
        }
      ]
    },
    "formless": {
      "id": "formless",
      "label": "Formless",
      "description": "I am the shape of my bodies.\nFlowing, filling the containers of mind and flesh.\nI envelop, absorb, change, become.\nThe world gives me form.",
      "effects": [
        {
          "type": "add_absorption_xp_conversion",
          "amount": 0.1,
          "description": "+10% [icon=xp]XP"
        }
      ]
    },
    "cache": {
      "id": "cache",
      "label": "Cache",
