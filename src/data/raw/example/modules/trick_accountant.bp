      "passport": {
        "label": "Trick Accountant",
        "icon": "trick_accountant",
        "description": "The accountant has been stealing.\n\nI have proof enough to send him to a Patriarchy dungeon — perhaps even into a mage’s laboratory.\n\nPerfect blackmail.\nI only need to confront him and make him come to the cave.",
