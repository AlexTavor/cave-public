      "notifications": [
        {
          "title": "Lovers Reunited",
          "text": "The accountant went pale when I walked his lover's body into his office.\n\nTerrified of discovery, he agreed to follow me into the forest. This body had loved him dearly. I could still feel the warmth of that love, and I savored it.\n\nOnce we were gone, I dragged a slave's corpse in from the market and set the office ablaze.\n\nWith luck, the Purge Inquisitors will take it for an accident and look no deeper.\n\nNow I can absorb them both.\n\nTheir love will become part of me forever.",
          "imageUrl": null,
          "id": "2W13MZEbqrThFnTpC1fBq"
        }
