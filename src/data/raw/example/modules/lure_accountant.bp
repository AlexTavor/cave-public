      "passport": {
        "label": "Lure Accountant",
        "icon": "lure_accountant",
        "description": "I can walk in wearing his lover’s body and ask him to come with me.\n\nThey adore each other. I am warmed by the memory of her love.\n\nHe will follow her anywhere.”",
